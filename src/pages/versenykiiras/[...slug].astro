---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('versenykiiras');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <article class="container page-content">
    <div class="article-header">
      <time class="article-date">{entry.data.date.toLocaleDateString('hu-HU')}</time>
      <h1 class="article-title">{entry.data.title}</h1>
      {entry.data.season && <p class="article-season">Szezon: {entry.data.season}</p>}
    </div>
    
    <div class="article-body prose">
      <Content />
    </div>
    
    <div class="article-footer">
      <a href="/versenykiiras/" class="back-link">&larr; Vissza a versenykiírásokhoz</a>
    </div>
  </article>
</BaseLayout>

<style>
  .page-content {
    padding: 3rem 1.5rem 5rem;
    max-width: 800px;
  }
  
  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--accent-gold);
  }
  
  .article-date {
    display: block;
    color: var(--accent-sky);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .article-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .article-season {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  
  .article-body {
    font-size: 1.125rem;
    color: var(--text-primary);
    line-height: 1.7;
  }
  
  .article-body :global(ul), .article-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  
  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }
  
  .back-link {
    font-weight: 600;
  }
</style>
