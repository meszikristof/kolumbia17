---
// Sveltia CMS admin entry page
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const configUrl = `${base}/admin/config.yml`;
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Tartalomkezelő (CMS) | Kolumbia Sport Klub</title>
    <link href={configUrl} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
    <script is:inline>
      const registerDocComponent = () => {
        if (window.CMS && typeof window.CMS.registerEditorComponent === 'function') {
          window.CMS.registerEditorComponent({
            id: 'document-embed',
            label: '📊 Dokumentum / Táblázat beágyazása',
            fields: [
              {
                name: 'file',
                label: 'Dokumentum fájl (Excel, Word, PDF)',
                widget: 'file',
                required: true,
              },
              {
                name: 'title',
                label: 'Megjelenő cím / Megnevezés (opcionális)',
                widget: 'string',
                required: false,
              }
            ],
            pattern: /^\[document-embed\s+src="([^"]+)"(?:\s+title="([^"]*)")?\]$/,
            fromBlock: function(match) {
              return {
                file: match[1],
                title: match[2] || '',
              };
            },
            toBlock: function(data) {
              return `[document-embed src="${data.file || ''}" title="${data.title || ''}"]`;
            },
            toPreview: function(data) {
              const file = data.file || 'Nincs fájl kiválasztva';
              const title = data.title ? `${data.title} (${file})` : file;
              return `<div style="padding: 12px 16px; border: 1.5px dashed #2D8CFF; border-radius: 8px; background: rgba(45, 140, 255, 0.06); font-family: sans-serif; display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1.25rem;">📄</span>
                <div>
                  <div style="font-weight: bold; color: #1B6FD1;">Beágyazott dokumentum / táblázat:</div>
                  <div style="color: #334155; font-size: 0.9rem;">${title}</div>
                </div>
              </div>`;
            }
          });
        } else {
          setTimeout(registerDocComponent, 150);
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', registerDocComponent);
      } else {
        registerDocComponent();
      }
    </script>
  </body>
</html>

