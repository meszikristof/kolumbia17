---
// Decap CMS admin entry page
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const configUrl = `${base}/admin/config.yml`;
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Tartalomkezelő (CMS) | Kolumbia Sport Klub</title>
    <link href={configUrl} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>
