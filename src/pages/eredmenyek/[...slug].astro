---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getUrl } from '../../utils/url';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const resultEntries = await getCollection('eredmenyek');
  return resultEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// If it's an external link, we ideally shouldn't render this page,
// but in case someone navigates to it directly, we can show a link.
---

<BaseLayout title={entry.data.title}>
  <article class="container page-content">
    <div class="article-header">
      <time class="article-date">{entry.data.date.toLocaleDateString('hu-HU')}</time>
      <h1 class="article-title">{entry.data.title}</h1>
      {entry.data.location && <p class="article-location">Helyszín: {entry.data.location}</p>}
    </div>
    
    {entry.data.featuredImage && (
      <Image src={entry.data.featuredImage} alt={entry.data.title} class="article-image" />
    )}
    
    <div class="article-body prose">
      {entry.data.type === 'külső_link' && entry.data.externalUrl ? (
        <p>
          Ez az eredmény egy külső oldalon található: 
          <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">{entry.data.externalUrl}</a>
        </p>
      ) : (
        <Content />
      )}
    </div>
    
    <div class="article-footer">
      <a href={getUrl('/eredmenyek/')} class="back-link">&larr; Vissza az eredményekhez</a>
    </div>
  </article>
</BaseLayout>

<style>
  .page-content {
    padding: 3rem 1.5rem 5rem;
    max-width: 800px;
  }
  
  .article-header {
    margin-bottom: 2rem;
  }
  
  .article-date {
    display: block;
    color: var(--accent-sky);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .article-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .article-location {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  
  .article-image {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 2rem;
  }
  
  .article-body {
    font-size: 1.125rem;
    color: var(--text-primary);
    line-height: 1.7;
  }
  
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  
  .article-body :global(th), .article-body :global(td) {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border-light);
    text-align: left;
  }
  
  .article-body :global(th) {
    background-color: var(--bg-accent);
    font-weight: 600;
  }
  
  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }
  
  .back-link {
    font-weight: 600;
  }
</style>
