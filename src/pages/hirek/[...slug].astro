---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getUrl } from '../../utils/url';

export async function getStaticPaths() {
  const newsEntries = await getCollection('hirek');
  return newsEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <article class="container page-content">
    <div class="article-header">
      <time class="article-date">{entry.data.date.toLocaleDateString('hu-HU')}</time>
      <h1 class="article-title">{entry.data.title}</h1>
      {entry.data.tags && (
        <div class="article-tags">
          {entry.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </div>
    
    {entry.data.featuredImage && (
      <img src={getUrl(entry.data.featuredImage)} alt={entry.data.title} class="article-image" />
    )}
    
    <div class="article-body prose">
      <Content />
    </div>
    
    <div class="article-footer">
      <a href={getUrl('/hirek/')} class="back-link">&larr; Vissza a hírekhez</a>
    </div>
  </article>
</BaseLayout>

<style>
  .page-content {
    padding: 3rem 1.5rem 5rem;
    max-width: 800px;
  }
  
  .article-header {
    margin-bottom: 2rem;
  }
  
  .article-date {
    display: block;
    color: var(--accent-sky);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .article-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .tag {
    background-color: var(--bg-accent);
    color: var(--text-secondary);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  
  .article-image {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 2rem;
  }
  
  .article-body {
    font-size: 1.125rem;
    color: var(--text-primary);
    line-height: 1.7;
  }
  
  .article-body :global(h2), .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }
  
  .article-body :global(ul), .article-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  
  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }
  
  .back-link {
    font-weight: 600;
  }
</style>
