---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";
import { getUrl } from "../utils/url";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A Kolumbia Sport Klub hivatalos weboldala." } =
  Astro.props;

const homeEntry = await getEntry("pages", "home");
const faviconUrl = homeEntry?.data.logo?.src || "/favicon.svg";
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Kolumbia Sport Klub</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={getUrl(faviconUrl)} />
    <ClientRouter />
    {
      homeEntry?.data.logo && (
        <link rel="preload" as="image" href={getUrl(homeEntry.data.logo.src)} />
      )
    }

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Check inline script to prevent flash of incorrect theme -->
    <script is:inline>
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <div id="img-lightbox" class="img-lightbox" aria-hidden="true">
      <div class="img-lightbox-backdrop"></div>
      <img class="img-lightbox-img" src="" alt="" />
    </div>

    <style is:global>
      .img-lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .img-lightbox.is-open {
        pointer-events: auto;
        opacity: 1;
      }
      .img-lightbox-backdrop {
        position: absolute;
        inset: 0;
        background: var(--bg-primary);
        opacity: 0.92;
      }
      .img-lightbox-img {
        position: relative;
        max-width: calc(100vw - 48px);
        max-height: calc(100vh - 48px);
        object-fit: contain;
        cursor: zoom-out;
        transform: scale(0.92);
        transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        border-radius: 4px;
      }
      .img-lightbox.is-open .img-lightbox-img {
        transform: scale(1);
      }
    </style>

    <script>
      function setupLightbox() {
        const lightbox = document.getElementById("img-lightbox");
        const lightboxImg = lightbox?.querySelector(".img-lightbox-img") as HTMLImageElement | null;
        if (!lightbox || !lightboxImg) return;

        function closeLightbox() {
          lightbox!.classList.remove("is-open");
          lightbox!.setAttribute("aria-hidden", "true");
        }

        // Kattintás a képre -> megnyitás
        document.addEventListener("click", (e: MouseEvent) => {
          const target = e.target as HTMLElement;
          if (target.tagName === "IMG" && target.closest(".prose, .article-image")) {
            const img = target as HTMLImageElement;
            lightboxImg!.src = img.src;
            lightboxImg!.alt = img.alt || "";
            lightbox!.classList.add("is-open");
            lightbox!.setAttribute("aria-hidden", "false");
          }
        });

        // Kattintás a lightboxra -> bezárás
        lightbox.addEventListener("click", closeLightbox);

        // ESC gomb -> bezárás
        document.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key === "Escape") closeLightbox();
        });
      }

      setupLightbox();
      document.addEventListener("astro:page-load", setupLightbox);
    </script>
  </body>
</html>
