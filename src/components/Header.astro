---
import ThemeToggle from "./ThemeToggle.astro";
import { getUrl } from "../utils/url";
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const homeEntry = await getEntry("pages", "home");
const logo = homeEntry?.data.logo;

const navItems = [
  { href: getUrl("/"), text: "Főoldal" },
  { href: getUrl("/hirek/"), text: "Hírek" },
  { href: getUrl("/eredmenyek/"), text: "Eredmények" },
  { href: getUrl("/versenykiiras/"), text: "Versenykiírás" },
  { href: getUrl("/dokumentumok/"), text: "Dokumentumok" },
  { href: getUrl("/galleria/"), text: "Galéria" },
  { href: getUrl("/rolunk/"), text: "Rólunk" },
];
---

<header class="header" id="site-header">
  <div class="container header-container" id="header-container">
    <a href={getUrl("/")} class="logo" id="site-logo">
      {
        logo && (
          <Image
            src={logo}
            alt="Kolumbia 17 Logo"
            class="logo-img"
            fetchpriority="high"
            decoding="sync"
          />
        )
      }
      <span class="logo-text">
        <span class="logo-accent">KOLUMBIA</span><span class="logo-number"
          >17</span
        >
      </span>
    </a>

    <button
      id="mobile-menu-btn"
      aria-label="Menü megnyitása"
      aria-expanded="false"
      aria-controls="main-nav"
      class="mobile-menu-btn"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav class="nav" id="main-nav">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-actions">
        <ThemeToggle />
        <div class="social-links">
          <a
            href="https://www.facebook.com/groups/kolumbiasportklub"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Facebook csoport"
            title="Facebook csoport"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@kolumbiasportklub4137"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="YouTube csatorna"
            title="YouTube csatorna"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"
              ></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"
              ></polygon>
            </svg>
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-decoration: none;
  }

  .logo-img {
    height: 42px;
    width: auto;
    max-width: 48px;
    object-fit: contain;
    border-radius: 4px;
    display: block;
  }

  .logo-text {
    display: inline-flex;
    align-items: baseline;
  }

  .logo-accent {
    color: var(--text-primary);
  }

  .logo-number {
    color: var(--accent-sky);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-link {
    color: var(--text-secondary);
    font-weight: 500;
    padding: 0.5rem 0;
  }

  .nav-link:hover {
    color: var(--accent-sky);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--border-light);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--border-light);
  }

  .social-link {
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 50%;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .social-link:hover {
    color: var(--accent-sky);
    background-color: var(--bg-accent);
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }

  .mobile-menu-btn:hover {
    background-color: var(--bg-accent);
  }

  /* Grouped/mobile layout styles: applied dynamically via .is-mobile-view class */
  .header.is-mobile-view .mobile-menu-btn {
    display: block;
  }

  .header.is-mobile-view .nav {
    display: none;
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;
    background-color: var(--bg-secondary);
    flex-direction: column;
    padding: 1rem;
    border-bottom: 1px solid var(--border-light);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .header.is-mobile-view .nav.is-open {
    display: flex;
  }

  .header.is-mobile-view .nav-list {
    flex-direction: column;
    width: 100%;
    gap: 0.5rem;
    align-items: stretch;
  }

  .header.is-mobile-view .nav-link {
    display: block;
    padding: 0.75rem;
    border-radius: 8px;
  }

  .header.is-mobile-view .nav-link:hover {
    background-color: var(--bg-accent);
  }

  .header.is-mobile-view .nav-actions {
    margin-top: 1rem;
    padding-top: 1rem;
    padding-left: 0;
    border-left: none;
    border-top: 1px solid var(--border-light);
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
  }

  /* Static fallback media query (max-width: 1080px):
     Guarantees no flash of unstyled content or overflow on initial page render,
     unless dynamic JS measurement explicitly verified desktop fits (.is-desktop-view). */
  @media (max-width: 1080px) {
    .header:not(.is-desktop-view) .mobile-menu-btn {
      display: block;
    }

    .header:not(.is-desktop-view) .nav {
      display: none;
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      background-color: var(--bg-secondary);
      flex-direction: column;
      padding: 1rem;
      border-bottom: 1px solid var(--border-light);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .header:not(.is-desktop-view) .nav.is-open {
      display: flex;
    }

    .header:not(.is-desktop-view) .nav-list {
      flex-direction: column;
      width: 100%;
      gap: 0.5rem;
      align-items: stretch;
    }

    .header:not(.is-desktop-view) .nav-link {
      display: block;
      padding: 0.75rem;
      border-radius: 8px;
    }

    .header:not(.is-desktop-view) .nav-link:hover {
      background-color: var(--bg-accent);
    }

    .header:not(.is-desktop-view) .nav-actions {
      margin-top: 1rem;
      padding-top: 1rem;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--border-light);
      width: 100%;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>

<script>
  let resizeRaf = 0;

  function checkHeaderFit() {
    const header = document.getElementById("site-header");
    const container = document.getElementById("header-container");
    const logo = document.getElementById("site-logo");
    const nav = document.getElementById("main-nav");

    if (!header || !container || !logo || !nav) return;

    // Measure unconstrained navigation width using an offscreen element
    // This accurately accounts for all nav links, actions, gaps, and font metrics
    // regardless of whether the navigation is currently visible or collapsed.
    const clone = nav.cloneNode(true);
    clone.id = "";
    clone.style.cssText =
      "position:absolute!important;visibility:hidden!important;display:flex!important;flex-direction:row!important;width:max-content!important;max-width:none!important;left:-9999px!important;top:-9999px!important;pointer-events:none!important;";

    const cloneList = clone.querySelector(".nav-list");
    if (cloneList) {
      cloneList.style.cssText =
        "display:flex!important;flex-direction:row!important;width:max-content!important;gap:1.5rem!important;";
    }

    document.body.appendChild(clone);
    const navWidth = clone.offsetWidth;
    document.body.removeChild(clone);

    const logoWidth = logo.offsetWidth;
    const containerStyle = window.getComputedStyle(container);
    const paddingLeft = parseFloat(containerStyle.paddingLeft) || 0;
    const paddingRight = parseFloat(containerStyle.paddingRight) || 0;
    const availableWidth = container.clientWidth - paddingLeft - paddingRight;

    // Minimum comfortable gap between logo and navigation (24px)
    const minGap = 24;
    const totalRequiredWidth = logoWidth + navWidth + minGap;

    if (availableWidth < totalRequiredWidth) {
      header.classList.add("is-mobile-view");
      header.classList.remove("is-desktop-view");
    } else {
      header.classList.remove("is-mobile-view");
      header.classList.add("is-desktop-view");
      // Close open mobile menu when returning to desktop mode
      if (nav.classList.contains("is-open")) {
        nav.classList.remove("is-open");
        const btn = document.getElementById("mobile-menu-btn");
        if (btn) {
          btn.setAttribute("aria-expanded", "false");
          btn.setAttribute("aria-label", "Menü megnyitása");
        }
      }
    }
  }

  function handleResize() {
    cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(checkHeaderFit);
  }

  // Initial calculation and lifecycle hooks for View Transitions
  document.addEventListener("astro:page-load", () => {
    checkHeaderFit();

    // Re-check once web fonts have fully loaded to ensure precise metrics
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(checkHeaderFit);
    }

    // Also re-check when the logo image finishes loading if not yet complete
    const logoImg = document.querySelector("#site-logo .logo-img");
    if (logoImg && !logoImg.complete) {
      logoImg.addEventListener("load", checkHeaderFit, { once: true });
    }
  });

  document.addEventListener("astro:after-swap", checkHeaderFit);

  window.addEventListener("resize", handleResize, { passive: true });

  // Handle menu toggle, link clicks, outside clicks, and Escape key
  document.addEventListener("click", (e) => {
    const target = e.target;
    const mobileMenuBtn = target.closest("#mobile-menu-btn");
    const mainNav = document.getElementById("main-nav");
    const header = document.getElementById("site-header");
    const navLink = target.closest(".nav-link");

    if (mobileMenuBtn) {
      if (mainNav) {
        const isOpen = mainNav.classList.toggle("is-open");
        mobileMenuBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
        mobileMenuBtn.setAttribute(
          "aria-label",
          isOpen ? "Menü bezárása" : "Menü megnyitása"
        );
      }
      return;
    }

    // Close menu when clicking a navigation link
    if (navLink && mainNav && mainNav.classList.contains("is-open")) {
      mainNav.classList.remove("is-open");
      const btn = document.getElementById("mobile-menu-btn");
      if (btn) {
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Menü megnyitása");
      }
      return;
    }

    // Close menu when clicking outside the header
    if (
      header &&
      !header.contains(target) &&
      mainNav &&
      mainNav.classList.contains("is-open")
    ) {
      mainNav.classList.remove("is-open");
      const btn = document.getElementById("mobile-menu-btn");
      if (btn) {
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Menü megnyitása");
      }
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const mainNav = document.getElementById("main-nav");
      if (mainNav && mainNav.classList.contains("is-open")) {
        mainNav.classList.remove("is-open");
        const btn = document.getElementById("mobile-menu-btn");
        if (btn) {
          btn.setAttribute("aria-expanded", "false");
          btn.setAttribute("aria-label", "Menü megnyitása");
        }
      }
    }
  });
</script>
