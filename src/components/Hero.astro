---
interface Props {
  title: string;
  bgImage?: string;
  bgVideo?: string;
  logo?: string;
  hideHeroTitle?: boolean;
}

const { title, bgImage, bgVideo, logo, hideHeroTitle = false } = Astro.props;
const hasCustomBackground = Boolean(bgImage || bgVideo);

const resolveUrl = (url: string | undefined) => {
  if (!url) return undefined;
  if (url.startsWith('http')) return url;
  if (url.startsWith('/')) {
    const base = import.meta.env.BASE_URL;
    const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
    return `${normalizedBase}${url}`;
  }
  return url;
};
---

<section class="hero">
  {bgVideo ? (
    <video autoplay loop muted playsinline class="hero-bg hero-video">
      <source src={resolveUrl(bgVideo)} type="video/mp4" />
    </video>
  ) : bgImage ? (
    <img 
      src={resolveUrl(bgImage)} 
      alt={title || "Kolumbia Sport Klub"} 
      class="hero-bg hero-image" 
      loading="eager" 
      fetchpriority="high"
    />
  ) : (
    <div class="hero-bg fallback-bg"></div>
  )}
  
  {(!hasCustomBackground || !hideHeroTitle) && <div class="hero-overlay"></div>}
  
  <div class="container hero-content">
    {logo ? (
      <img src={resolveUrl(logo)} alt={title} class="hero-logo" />
    ) : hideHeroTitle ? (
      <h1 class="sr-only">{title}</h1>
    ) : (
      <h1 class="hero-title">{title}</h1>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--bg-primary);
  }
  
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .fallback-bg {
    background-color: var(--accent-sky);
    background-image: linear-gradient(135deg, var(--accent-sky) 0%, var(--accent-field) 100%);
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 20, 25, 0.4);
    z-index: 1;
  }
  
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  
  .hero-logo {
    max-width: 300px;
    height: auto;
  }
  
  .hero-title {
    color: #FFFFFF;
    font-size: clamp(2.5rem, 5vw, 4rem);
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero {
      aspect-ratio: 16 / 9;
      max-height: none;
    }
  }
</style>

