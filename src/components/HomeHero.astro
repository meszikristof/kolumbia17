---
import { Image } from 'astro:assets';
import pecset from '../assets/images/uploads/pecset.png';
import logo from '../assets/images/uploads/logo.png';
---

<section class="home-hero" aria-label="Kolumbia Sport Klub Versenykerület">
  <div class="hero-container">
    <!-- Bal oldali logó (pecsét) -->
    <div class="logo-wrap logo-left">
      <Image
        src={pecset}
        alt="Kolumbia Postagalamb Sport Egyesület pecsét"
        class="hero-logo"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Középső felirat -->
    <div class="hero-center">
      <h1 class="hero-title">
        <span class="title-line-1">Kolumbia Sport Klub</span>
        <span class="title-line-2">Versenykerület</span>
      </h1>
    </div>

    <!-- Jobb oldali logó -->
    <div class="logo-wrap logo-right">
      <Image
        src={logo}
        alt="Kolumbia Postagalamb Sport Versenykerület logó"
        class="hero-logo"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700;1,800&display=swap');

  .home-hero {
    width: 100%;
    min-height: clamp(340px, 40vh, 480px);
    background-color: var(--bg-secondary, #ffffff);
    padding: 5.5rem 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  html.dark .home-hero {
    background-color: var(--bg-secondary, #1a2332);
  }

  /* 3 oszlopos rács: bal logó | szöveg | jobb logó - kizárt hogy egymás alá essenek */
  .hero-container {
    width: 100%;
    max-width: 1120px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    justify-items: center;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    margin: 0 auto;
  }

  /* Logók */
  .logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-logo {
    width: clamp(95px, 14vw, 180px);
    height: clamp(95px, 14vw, 180px);
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.08));
  }

  /* Középső szöveg */
  .hero-center {
    width: 100%;
    text-align: center;
    min-width: 0;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 800;
    color: #1e5a26;
    line-height: 1.18;
    margin: 0;
    letter-spacing: -0.015em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  .title-line-1 {
    display: block;
    font-size: clamp(1.6rem, 3.8vw, 3.3rem);
  }

  .title-line-2 {
    display: block;
    font-size: clamp(1.35rem, 3.2vw, 2.75rem);
    font-weight: 700;
    opacity: 0.95;
    margin-top: 0.15rem;
  }

  html.dark .hero-title {
    color: #5ec96e;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  /* Reszponzív (mobil kijelzők) */
  @media (max-width: 640px) {
    .home-hero {
      min-height: 220px;
      padding: 3rem 0.75rem;
    }

    .hero-container {
      gap: 0.75rem;
    }

    .hero-logo {
      width: clamp(52px, 15vw, 76px);
      height: clamp(52px, 15vw, 76px);
    }

    .title-line-1 {
      font-size: clamp(1.05rem, 4.4vw, 1.45rem);
    }

    .title-line-2 {
      font-size: clamp(0.9rem, 3.8vw, 1.25rem);
    }
  }
</style>

